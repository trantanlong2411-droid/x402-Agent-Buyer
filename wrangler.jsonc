{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x402-agent-buyer",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BUYER_TASKS",
        "class_name": "BuyerTask"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BuyerTask"
      ]
    }
  ],
  "vars": {
    "SELLER_ORIGIN": "https://x402-paywalled-api.trantanlong2411.workers.dev",
    "ATLANTIC_RPC_URL": "https://atlantic.dplabs-internal.com"
  }
}
